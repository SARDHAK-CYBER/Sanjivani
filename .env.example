# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (e.g. a Neon *pooled* URL). SQLite `file:` URLs are no longer supported.
# Apply the schema with: npm run db:migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# DB_POOL_MAX=5

# ─── App secrets ─────────────────────────────────────────────────────────────
# Generate all three with: npm run gen:secrets
# JWT_SECRET and BYSTANDER_JWT_SECRET must be >= 32 chars and DIFFERENT from each other.
# ENCRYPTION_KEY is 32 random bytes, base64. Back it up: losing it makes every encrypted field unreadable.
JWT_SECRET=""
BYSTANDER_JWT_SECRET=""
ENCRYPTION_KEY=""

# ─── Public URLs / networking ────────────────────────────────────────────────
# Base URL used in emailed links. REQUIRED in production (never taken from the request Host header).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# What QR codes point at. Defaults to the site origin; set to a LAN address to test scanning from a phone.
# NEXT_PUBLIC_QR_BASE_URL="http://192.168.1.20:3000"
# Extra hosts allowed to reach `next dev` (comma separated).
# ALLOWED_DEV_ORIGINS="192.168.1.20"
# Number of reverse proxies you operate in front of the app (used to read the real client IP). Vercel: 1.
# TRUSTED_PROXY_HOPS=1

# ═══ Phone verification: MSG91 OTP Widget ════════════════════════════════════
# Phone codes prove a phone number: at registration, when someone scans a QR code, when a member changes their
# number, and to authorise setting up (or replacing) an authenticator app. Member sign-in itself uses the
# authenticator app (TOTP), which needs no configuration.
#
# MSG91's OTP Widget sends and checks the code itself (WhatsApp/SMS/voice/email, chosen in the widget's own
# dashboard settings, with its own captcha) and hands the browser a JWT as proof. Our server then asks MSG91
# to confirm that JWT (src/lib/msg91-widget.ts) before trusting it -- see that file's docstring for the
# current caveats on exactly what MSG91's response does and doesn't let us verify server-side; that's an
# open thread with MSG91 support as of this integration, not a settled design.
#
# Get all four values from your MSG91 dashboard: Widgets > (your widget) > Client Side Integration.
# widgetId/tokenAuth are NOT secret -- they're meant to sit in browser code. authkey IS secret; keep it
# server-side only.
NEXT_PUBLIC_MSG91_WIDGET_ID=""
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=""
MSG91_AUTH_KEY=""
# Override only if MSG91 ever asks you to use a region-specific verifyAccessToken endpoint.
# MSG91_WIDGET_VERIFY_URL="https://control.msg91.com/api/v5/widget/verifyAccessToken"

# Countries we accept as valid input before ever calling MSG91. India only by default.
# OTP_ALLOWED_COUNTRY_CODES="+91"
# Circuit breaker: total codes sent per rolling day, whoever asks (bounds the worst-case MSG91 bill). Default 2000.
# OTP_DAILY_LIMIT=2000

# --- Cloudflare Turnstile (optional extra bot check around the widget's own captcha) ---
# dash.cloudflare.com > Turnstile > add a site.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ─── Email (password reset links): required ──────────────────────────────────
# Password-reset emails are really sent through this SMTP server. Without it, resets cannot work (the request is
# logged as a misconfiguration; the page still answers generically so account existence is not revealed).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sanjivani <no-reply@your-domain.edu>"

# ─── Rate limiting (optional) ────────────────────────────────────────────────
# With Upstash Redis configured it is used; otherwise limits are counted in Postgres (works across instances).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── File storage ────────────────────────────────────────────────────────────
# Defaults to ./storage/uploads. Local disk does not persist on serverless hosts: see src/lib/storage.ts.
# STORAGE_DIR=""
