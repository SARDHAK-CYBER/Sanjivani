# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (e.g. a Neon *pooled* URL). SQLite `file:` URLs are no longer supported.
# Apply the schema with: npm run db:migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# DB_POOL_MAX=5

# ─── App secrets ─────────────────────────────────────────────────────────────
# Generate all three with: npm run gen:secrets
# JWT_SECRET and BYSTANDER_JWT_SECRET must be >= 32 chars and DIFFERENT from each other.
# ENCRYPTION_KEY is 32 random bytes, base64. Back it up: losing it makes every encrypted field unreadable.
JWT_SECRET=""
BYSTANDER_JWT_SECRET=""
ENCRYPTION_KEY=""

# ─── Public URLs / networking ────────────────────────────────────────────────
# Base URL used in emailed links. REQUIRED in production (never taken from the request Host header).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# What QR codes point at. Defaults to the site origin; set to a LAN address to test scanning from a phone.
# NEXT_PUBLIC_QR_BASE_URL="http://192.168.1.20:3000"
# Extra hosts allowed to reach `next dev` (comma separated).
# ALLOWED_DEV_ORIGINS="192.168.1.20"
# Number of reverse proxies you operate in front of the app (used to read the real client IP). Vercel: 1.
# TRUSTED_PROXY_HOPS=1

# ═══ Phone verification: Fast2SMS (SMS) ══════════════════════════════════════
# Phone codes prove a phone number: at registration, when someone scans a QR code, when a member changes their
# number, and to authorise setting up (or replacing) an authenticator app. Member sign-in itself uses the
# authenticator app (TOTP), which needs no configuration.
#
# We generate the 6-digit code ourselves, hash and store it, and use Fast2SMS only as an SMS pipe to deliver
# it (src/lib/otp/service.ts, src/lib/otp/transport.ts) -- Fast2SMS never decides whether a code is correct.
# Chosen over MSG91 specifically because Fast2SMS's "Quick SMS" route (route=q) sends a free-form message
# without requiring a DLT-registered Sender ID/template, which MSG91's SMS products all require for India.
#
# Get your key from fast2sms.com > Dev API > API Key. You also need a wallet top-up of at least ₹100 in a
# single transaction before the API will accept requests (a smaller/free trial balance is not enough).
FAST2SMS_API_KEY=""
# Override only if Fast2SMS ever asks you to use a different endpoint.
# FAST2SMS_URL="https://www.fast2sms.com/dev/bulkV2"

# Countries we accept as valid input before ever calling Fast2SMS. India only by default (Quick SMS is India-only anyway).
# OTP_ALLOWED_COUNTRY_CODES="+91"
# Gap required between resends of the same challenge, in seconds. Default 30.
# OTP_RESEND_COOLDOWN_SECONDS=30
# Circuit breaker: total codes sent per rolling day, whoever asks (bounds the worst-case bill). Default 2000.
# OTP_DAILY_LIMIT=2000

# Quick real-world check with your own phone once the above is set: npm run otp:smoke -- +919876543210

# --- Cloudflare Turnstile (bot check on the public "send code" step for register/bystander) ---
# dash.cloudflare.com > Turnstile > add a site. Without it, those two anonymous send endpoints have no captcha.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ─── Email (password reset links): required ──────────────────────────────────
# Password-reset emails are really sent through this SMTP server. Without it, resets cannot work (the request is
# logged as a misconfiguration; the page still answers generically so account existence is not revealed).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sanjivani <no-reply@your-domain.edu>"

# ─── Rate limiting (optional) ────────────────────────────────────────────────
# With Upstash Redis configured it is used; otherwise limits are counted in Postgres (works across instances).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── File storage ────────────────────────────────────────────────────────────
# Vercel Blob is used when BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID is set (needed on serverless hosts like
# Vercel, where local disk does not persist between invocations); otherwise files go to local disk (default
# ./storage/uploads, override with STORAGE_DIR) -- fine for local dev, no cloud credentials needed. See
# src/lib/storage.ts.
#
# On Vercel: Project > Storage > Create Database > Blob, then connect it to this project. That adds
# BLOB_STORE_ID (+ BLOB_WEBHOOK_PUBLIC_KEY) automatically and the SDK authenticates via OIDC -- you do not
# need to set BLOB_READ_WRITE_TOKEN by hand in that case. BLOB_READ_WRITE_TOKEN is only needed for local dev
# (`vercel env pull` after creating the store) or if you create a store without connecting it to a project.
# BLOB_READ_WRITE_TOKEN=""
# STORAGE_DIR=""
